{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-icat",
    "source": "~/Downloads/animation.gif",
    "padding": {
      "right": 4
    },
    "width": 20
  },
  "modules": [
    "title",
    "separator",
    {
	    "type": "os",
	    "key": "dis",
	    "format": "{name}"
    },
    {
	    "type": "wm",
	    "key": "wm",
	    "format": "{1}"
    },
    {	
      "type": "packages",
      "key": "pkg",
      "format": "{all}"
    },
    {	
      "type": "memory",
      "key": "mem",
      "format": "{used}/{total}"
    },
    {	
      "type": "cpuusage",
      "key": "cpu"
    },
    {	
      "type": "command",
      "key": "net",
      "text": "if ip route | grep -q default; then echo online ; else echo offline; fi"

    },
    {	
      "type": "datetime",
      "key": " "
    },
    "separator",
    "break"
  ]
}
